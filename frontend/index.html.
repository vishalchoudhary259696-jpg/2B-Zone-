<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>2B Zone | Gaming Cafe & Cinema</title>
<meta name="description" content="2B Zone gaming cafe and cinema. Check showtimes, book movie tickets and pay by UPI." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet" />
<style>
/* ==========================================================
   2B ZONE · Design tokens
   ========================================================== */
:root{
  --bg:#070A0F;
  --bg-2:#0C1118;
  --surface:rgba(16,22,30,.62);
  --surface-solid:#0F151D;
  --border:rgba(255,255,255,.09);
  --border-strong:rgba(255,255,255,.16);
  --text:#EDF2F7;
  --muted:#8B98AB;
  --accent:#2FE0B0;
  --accent-hover:#5BEFC6;
  --warn:#FF7A59;
  --radius:4px;
  --font-display:'Oswald',Impact,'Arial Narrow',sans-serif;
  --font-body:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
}

/* ==========================================================
   Base
   ========================================================== */
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  margin:0;min-height:100vh;overflow-x:hidden;
  font-family:var(--font-body);color:var(--text);line-height:1.6;
  -webkit-font-smoothing:antialiased;
  background:
    radial-gradient(900px 520px at 85% -8%, rgba(47,224,176,.14), transparent 60%),
    radial-gradient(760px 420px at -8% 35%, rgba(70,110,255,.10), transparent 62%),
    linear-gradient(180deg,var(--bg-2) 0%,var(--bg) 55%);
  background-attachment:fixed;
}
/* subtle engineering-grid texture behind everything */
body::before{
  content:"";position:fixed;inset:0;z-index:0;pointer-events:none;
  background-image:
    linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);
  background-size:64px 64px;
  -webkit-mask-image:radial-gradient(ellipse at top,#000 25%,transparent 78%);
          mask-image:radial-gradient(ellipse at top,#000 25%,transparent 78%);
}
.page{position:relative;z-index:1}
a{color:inherit;text-decoration:none}
button,input,select{font:inherit;color:inherit}
img{display:block;max-width:100%}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.wrap{width:min(1200px,calc(100% - 48px));margin-inline:auto}

/* ==========================================================
   Shared components
   ========================================================== */
.kicker{
  display:flex;align-items:center;gap:12px;margin:0;
  font-size:12px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);
}
.kicker::before{content:"";width:24px;height:1px;background:var(--accent)}

.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:10px;
  height:48px;padding:0 24px;border-radius:var(--radius);
  border:1px solid transparent;font-size:14px;font-weight:600;letter-spacing:.02em;
  cursor:pointer;transition:background .2s,border-color .2s,color .2s,transform .2s;
}
.btn-accent{background:var(--accent);color:#03130E}
.btn-accent:hover{background:var(--accent-hover)}
.btn-outline{background:rgba(255,255,255,.02);border-color:var(--border-strong);color:var(--text)}
.btn-outline:hover{border-color:var(--accent);color:var(--accent)}
.btn-sm{height:40px;padding:0 18px;font-size:13px}
.btn-block{width:100%}

.glass{
  background:var(--surface);
  -webkit-backdrop-filter:blur(16px) saturate(130%);
          backdrop-filter:blur(16px) saturate(130%);
  border:1px solid var(--border);
  border-radius:var(--radius);
}

/* ==========================================================
   Header
   ========================================================== */
.site-header{
  position:sticky;top:0;z-index:50;
  background:rgba(7,10,15,.62);
  -webkit-backdrop-filter:blur(14px) saturate(140%);
          backdrop-filter:blur(14px) saturate(140%);
  border-bottom:1px solid var(--border);
}
.nav{position:relative;display:flex;align-items:center;justify-content:space-between;gap:24px;height:72px}
.brand{display:flex;align-items:center;gap:12px}
.mark{
  width:38px;height:38px;border-radius:var(--radius);
  background:var(--accent);color:#03130E;
  display:grid;place-items:center;
  font-family:var(--font-display);font-weight:700;font-size:18px;letter-spacing:.5px;
}
.brand-name{
  display:block;font-family:var(--font-display);font-weight:600;
  font-size:20px;letter-spacing:.08em;text-transform:uppercase;line-height:1.1;
}
.brand-sub{
  display:block;margin-top:3px;font-size:10px;letter-spacing:.2em;
  text-transform:uppercase;color:var(--muted);
}
.nav-links{display:flex;align-items:center;gap:30px}
.nav-links a{font-size:14px;font-weight:500;color:var(--muted);transition:color .2s}
.nav-links a:hover{color:var(--text)}
.nav-cta{display:flex;align-items:center;gap:12px}
.menu-toggle{
  display:none;height:40px;padding:0 14px;border-radius:var(--radius);
  background:transparent;border:1px solid var(--border-strong);
  font-size:12px;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;
}

/* ==========================================================
   Hero
   ========================================================== */
.hero{padding:96px 0 80px}
.hero-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:64px;align-items:center}
.hero h1{
  margin:22px 0 24px;
  font-family:var(--font-display);font-weight:700;text-transform:uppercase;
  font-size:clamp(56px,8.4vw,112px);line-height:.92;letter-spacing:-.005em;
}
.hero h1 .accent{color:var(--accent)}
.lead{margin:0;max-width:520px;font-size:17px;color:var(--muted)}
.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:36px}

.spec-head{
  display:flex;justify-content:space-between;align-items:center;
  padding:18px 22px;border-bottom:1px solid var(--border);
}
.spec-head span{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}
.spec-head b{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);font-weight:600}
.spec-row{
  display:flex;justify-content:space-between;align-items:baseline;gap:16px;
  padding:20px 22px;border-bottom:1px solid var(--border);
}
.spec-row:last-child{border-bottom:0}
.spec-row span{font-size:13px;color:var(--muted)}
.spec-row strong{font-family:var(--font-display);font-size:32px;font-weight:600;letter-spacing:.01em}

/* ==========================================================
   Sections
   ========================================================== */
.section{padding:88px 0}
.section-head{
  display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;
  gap:24px;margin-bottom:40px;
}
.section-head h2{
  margin:14px 0 0;font-family:var(--font-display);font-weight:700;text-transform:uppercase;
  font-size:clamp(38px,4.8vw,58px);line-height:1;
}
.section-head p{max-width:420px;margin:0;font-size:15px;color:var(--muted)}

/* ==========================================================
   Movie carousel
   ========================================================== */
.stage{position:relative;overflow:hidden}
.slides{display:grid}
.slide{grid-area:1/1;visibility:hidden;opacity:0}
.slide.active{visibility:visible;opacity:1;animation:inLeft .7s cubic-bezier(.2,.7,.2,1) both}
.slide.leaving{visibility:visible;opacity:1;animation:outRight .55s ease-in both}
.slide.active .poster{animation:posterIn .6s .12s both}
.slide.active .fx{animation:rise .55s var(--d,.2s) both}

.slide-inner{
  display:grid;grid-template-columns:300px 1fr;gap:48px;align-items:center;padding:40px;
}
.poster{
  position:relative;width:100%;aspect-ratio:2/3;overflow:hidden;
  border-radius:var(--radius);border:1px solid var(--border-strong);
  background:linear-gradient(165deg,var(--c1),var(--c2));
  box-shadow:0 30px 60px -28px rgba(0,0,0,.9);
}
.poster::after{
  content:"";position:absolute;inset:0;pointer-events:none;
  background:repeating-linear-gradient(135deg,rgba(255,255,255,.05) 0 2px,transparent 2px 14px);
}
.poster img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:1}
.poster-tag{
  position:absolute;top:0;left:0;z-index:2;
  padding:7px 11px;background:var(--accent);color:#03130E;
  font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
}
.poster-title{
  position:absolute;left:0;right:0;bottom:0;z-index:2;padding:26px 22px;
  font-family:var(--font-display);font-weight:700;font-size:34px;line-height:1;text-transform:uppercase;
  background:linear-gradient(transparent,rgba(0,0,0,.7));
}

.info .kicker{margin-bottom:0}
.info h3{
  margin:14px 0 18px;font-family:var(--font-display);font-weight:700;text-transform:uppercase;
  font-size:clamp(40px,4.4vw,60px);line-height:.98;
}
.specs{
  display:grid;grid-template-columns:auto 1fr;gap:12px 24px;
  margin:0 0 22px;padding-top:18px;border-top:1px solid var(--border);font-size:14px;
}
.specs dt{align-self:center;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.specs dd{margin:0}
.desc{max-width:560px;margin:0 0 26px;font-size:15px;color:var(--muted)}
.times-label{margin:0 0 12px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
.times{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px}
.show{
  display:block;text-align:left;cursor:pointer;
  padding:14px 16px;border-radius:var(--radius);
  background:rgba(255,255,255,.025);border:1px solid var(--border-strong);
  transition:border-color .2s,background .2s;
}
.show:hover{border-color:var(--accent);background:rgba(47,224,176,.06)}
.show.unlocked{border-color:rgba(47,224,176,.5)}
.show-time{display:block;font-family:var(--font-display);font-size:22px;font-weight:600;letter-spacing:.02em;line-height:1.1}
.show-meta{display:block;margin-top:6px;font-size:12px;color:var(--muted)}
.meter{display:block;height:3px;margin-top:10px;background:rgba(255,255,255,.1);overflow:hidden}
.meter i{display:block;height:100%;background:var(--accent)}
.actions{margin-top:28px}

.controls{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:20px}
.ctrl-btns{display:flex;gap:10px}
.ctrl-btns button{
  width:42px;height:42px;border-radius:var(--radius);
  background:var(--surface);border:1px solid var(--border-strong);
  font-size:16px;cursor:pointer;transition:border-color .2s,color .2s;
}
.ctrl-btns button:hover{border-color:var(--accent);color:var(--accent)}
.counter{font-family:var(--font-display);font-size:18px;letter-spacing:.1em;color:var(--muted)}
.counter b{color:var(--text);font-weight:600}
.progress{height:2px;margin-top:22px;background:rgba(255,255,255,.08);overflow:hidden}
.bar{height:100%;width:0;background:var(--accent)}
.note{margin:16px 0 0;font-size:12px;color:var(--muted)}

/* ==========================================================
   Pricing tiers
   ========================================================== */
.tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.tier{position:relative;display:flex;flex-direction:column;padding:34px 30px}
.tier.featured{border-color:rgba(47,224,176,.55);box-shadow:0 30px 60px -36px rgba(47,224,176,.35)}
.tier-badge{
  position:absolute;top:-1px;right:-1px;
  padding:6px 12px;background:var(--accent);color:#03130E;
  font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
}
.tier-name{margin:0;font-size:12px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}
.tier-price{
  margin:18px 0 6px;font-family:var(--font-display);font-weight:700;font-size:64px;line-height:1;
}
.tier-price small{
  margin-left:8px;font-family:var(--font-body);font-size:14px;font-weight:500;color:var(--muted);
}
.tier-desc{
  margin:0 0 24px;padding-bottom:24px;border-bottom:1px solid var(--border);
  font-size:14px;color:var(--muted);
}
.tier ul{list-style:none;margin:0 0 30px;padding:0;display:grid;gap:13px;flex:1}
.tier li{position:relative;padding-left:26px;font-size:14px}
.tier li::before{
  content:"";position:absolute;left:3px;top:7px;width:8px;height:4px;
  border-left:2px solid var(--accent);border-bottom:2px solid var(--accent);
  transform:rotate(-45deg);
}

/* ==========================================================
   Footer
   ========================================================== */
.site-footer{
  margin-top:40px;padding:72px 0 28px;
  background:rgba(7,10,15,.7);border-top:1px solid var(--border);
}
.footer-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:40px}
.footer h4{
  margin:0 0 16px;font-size:12px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);
}
.footer p,.footer li{margin:0 0 8px;font-size:14px;color:var(--muted);list-style:none}
.footer a:hover{color:var(--text)}
.footer ul{margin:0;padding:0}
.footer-bottom{
  display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;
  margin-top:56px;padding-top:22px;border-top:1px solid var(--border);
  font-size:12px;color:var(--muted);
}

/* ==========================================================
   Booking modal
   ========================================================== */
.modal{
  position:fixed;inset:0;z-index:100;display:none;
  align-items:center;justify-content:center;padding:20px;
  background:rgba(3,5,8,.72);
  -webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);
}
.modal.open{display:flex;animation:fade .2s ease both}
.dialog{
  width:min(520px,100%);max-height:92vh;overflow:auto;padding:30px;
  background:rgba(14,19,27,.97);border:1px solid var(--border-strong);border-radius:var(--radius);
}
.dialog-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:22px}
.dialog h3{margin:0;font-family:var(--font-display);font-weight:700;font-size:30px;line-height:1;text-transform:uppercase}
.dialog-head p{margin:8px 0 0;font-size:13px;color:var(--muted)}
.icon-btn{
  width:36px;height:36px;flex-shrink:0;border-radius:var(--radius);
  background:transparent;border:1px solid var(--border);color:var(--muted);font-size:15px;cursor:pointer;
}
.icon-btn:hover{color:var(--text);border-color:var(--border-strong)}
.field{display:block;margin-bottom:16px}
.field > span{
  display:block;margin-bottom:7px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);
}
.input{
  width:100%;height:46px;padding:0 14px;
  background:rgba(255,255,255,.03);border:1px solid var(--border-strong);border-radius:var(--radius);
  font-size:15px;
}
.input:focus{outline:none;border-color:var(--accent)}
select.input option{background:#0F151D;color:var(--text)}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.pay-box{
  margin:4px 0 18px;padding:16px;
  background:rgba(255,255,255,.02);border:1px solid var(--border);border-radius:var(--radius);
}
.pay-line{
  display:flex;justify-content:space-between;align-items:center;gap:12px;
  margin-bottom:12px;font-size:14px;color:var(--muted);
}
.pay-line b{color:var(--text);font-weight:600}
.pay-total{
  display:flex;justify-content:space-between;align-items:baseline;
  padding-top:14px;margin-top:2px;border-top:1px solid var(--border);
  font-family:var(--font-display);font-size:28px;
}
.copy-btn{
  height:30px;padding:0 12px;margin-left:8px;
  background:transparent;border:1px solid var(--border-strong);border-radius:var(--radius);
  font-size:12px;cursor:pointer;
}
.copy-btn:hover{border-color:var(--accent);color:var(--accent)}
.error{min-height:20px;margin:0 0 12px;font-size:13px;color:var(--warn)}
.success-box{text-align:center;padding:8px 0}
.success-box h3{margin:0 0 10px}
.success-box p{margin:0 0 22px;font-size:14px;color:var(--muted)}
.success-mark{
  width:56px;height:56px;margin:0 auto 18px;display:grid;place-items:center;
  background:var(--accent);color:#03130E;border-radius:var(--radius);font-size:26px;font-weight:700;
}

/* ==========================================================
   Keyframes
   ========================================================== */
@keyframes inLeft{from{transform:translateX(-100%);opacity:0}to{transform:none;opacity:1}}
@keyframes outRight{from{transform:none;opacity:1}to{transform:translateX(100%);opacity:0}}
@keyframes rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
@keyframes posterIn{from{opacity:0;transform:translateX(-30px)}to{opacity:1;transform:none}}
@keyframes fade{from{opacity:0}to{opacity:1}}
@keyframes fill{from{width:0}to{width:100%}}

/* ==========================================================
   Responsive
   ========================================================== */
@media (max-width:980px){
  .hero-grid{grid-template-columns:1fr;gap:48px}
  .tiers{grid-template-columns:1fr;max-width:520px}
  .footer-grid{grid-template-columns:1fr 1fr}
}
@media (max-width:720px){
  .wrap{width:calc(100% - 32px)}
  .menu-toggle{display:block}
  .nav-links{
    display:none;position:absolute;top:72px;left:0;right:0;
    flex-direction:column;align-items:flex-start;gap:18px;padding:22px 24px;
    background:rgba(7,10,15,.97);border-bottom:1px solid var(--border);
  }
  .nav-links.open{display:flex}
  .hero{padding:56px 0 56px}
  .section{padding:64px 0}
  .spec-row strong{font-size:26px}
  .slide-inner{grid-template-columns:1fr;gap:28px;padding:24px}
  .poster{max-width:220px;margin:0 auto}
  .grid-2{grid-template-columns:1fr}
  .footer-grid{grid-template-columns:1fr}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms !important;transition-duration:.01ms !important}
  html{scroll-behavior:auto}
}
</style>
</head>
<body>

<div class="page">

  <!-- ============ HEADER ============ -->
  <header class="site-header">
    <div class="wrap nav">
      <a class="brand" href="#home">
        <span class="mark">2B</span>
        <span>
          <span class="brand-name">2B Zone</span>
          <span class="brand-sub">Gaming Cafe &amp; Cinema</span>
        </span>
      </a>

      <nav class="nav-links" id="navLinks">
        <a href="#movies">Movies</a>
        <a href="#pricing">Pricing</a>
        <a href="#visit">Visit</a>
      </nav>

      <div class="nav-cta">
        <a href="#movies" class="btn btn-accent btn-sm">Book tickets</a>
        <button class="menu-toggle" id="menuToggle" aria-expanded="false" aria-controls="navLinks">Menu</button>
      </div>
    </div>
  </header>

  <main>
    <!-- ============ HERO ============ -->
    <section class="hero" id="home">
      <div class="wrap hero-grid">
        <div>
          <p class="kicker">Gaming cafe and cinema</p>
          <h1>The big screen.<br /><span class="accent">Your crew.</span></h1>
          <p class="lead">Pick a film, choose a showtime and pay by UPI. Built for friends, families and groups who want a proper night out.</p>
          <div class="hero-actions">
            <a href="#movies" class="btn btn-accent">Browse showtimes</a>
            <a href="#pricing" class="btn btn-outline">View pricing</a>
          </div>
        </div>

        <aside class="spec glass" aria-label="Booking details">
          <div class="spec-head">
            <span>Booking details</span>
            <b>UPI payments</b>
          </div>
          <div class="spec-row"><span>Price per ticket</span><strong>₹99</strong></div>
          <div class="spec-row"><span>Tickets to unlock a show</span><strong>5</strong></div>
          <div class="spec-row"><span>Seats per show</span><strong>30</strong></div>
        </aside>
      </div>
    </section>

    <!-- ============ MOVIES ============ -->
    <section class="section" id="movies">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="kicker">Now showing &amp; upcoming</p>
            <
              <h2>Choose your film</h2>
          </div>
          <p>Titles rotate automatically. Hover or swipe to pause, then select a showtime to book.</p>
        </div>

        <div class="stage glass" id="stage">
          <div class="slides" id="slides"></div>
        </div>

        <div class="controls">
          <div class="ctrl-btns">
            <button id="prev" aria-label="Previous film">←</button>
            <button id="next" aria-label="Next film">→</button>
          </div>
          <div class="counter" id="counter"></div>
        </div>
        <div class="progress"><div class="bar" id="bar"></div></div>

        <p class="note">Showtimes and seat counts are sample data. Connect a booking backend before going live.</p>
      </div>
    </section>

    <!-- ============ PRICING ============ -->
    <section class="section" id="pricing">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="kicker">Pricing</p>
            <h2>Ways to watch</h2>
          </div>
          <p>One flat price per ticket. A show opens once enough tickets are paid.</p>
        </div>

        <div class="tiers">
          <article class="tier glass">
            <p class="tier-name">Single seat</p>
            <div class="tier-price">₹99<small>per ticket</small></div>
            <p class="tier-desc">For solo viewers or anyone joining a show that is already open.</p>
            <ul>
              <li>Any listed showtime</li>
              <li>Payment by UPI</li>
              <li>Confirmed after payment check</li>
            </ul>
            <a href="#movies" class="btn btn-outline btn-block">Book a seat</a>
          </article>

          <article class="tier glass featured">
            <span class="tier-badge">Recommended</span>
            <p class="tier-name">Crew of five</p>
            <div class="tier-price">₹495<small>for 5 tickets</small></div>
            <p class="tier-desc">The minimum needed to unlock a show. Ideal for a group of friends.</p>
            <ul>
              <li>Unlocks the show at 5 paid tickets</li>
              <li>One booking for the whole group</li>
