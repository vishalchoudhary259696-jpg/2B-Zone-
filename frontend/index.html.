    </section>
  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="site-footer" id="visit">
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <div class="brand-name">2B Zone</div>
          <p style="margin-top:14px">Gaming cafe and cinema for groups, friends and families.</p>
        </div>
        <div>
          <h4>Navigate</h4>
          <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#movies">Movies</a></li>
            <li><a href="#pricing">Pricing</a></li>
          </ul>
        </div>
        <div>
          <h4>Visit</h4>
          <p>[Your address]</p>
          <p>[Opening hours]</p>
        </div>
