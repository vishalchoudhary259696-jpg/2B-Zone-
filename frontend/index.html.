<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>2B Zone | Gaming Cafe and Cinema</title>
  <meta name="description" content="2B Zone is a gaming cafe and movie screening room. Check showtimes, book tickets and pay by UPI.">
  <meta name="theme-color" content="#0F1012">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600&display=swap">
  <link rel="stylesheet" href="css/style.css">
  <script src="js/script.js" defer></script>
</head>
<body id="top">

<a class="skip-link" href="#main">Skip to content</a>

<!-- ============ HEADER ============ -->
<header class="site-header" id="siteHeader">
  <div class="container header-inner">
    <a class="logo" href="#top" aria-label="2B Zone home">
      <span class="logo-mark" aria-hidden="true">2B</span>
      <span class="logo-text">Zone<small>Gaming Cafe &amp; Cinema</small></span>
    </a>

    <button class="nav-toggle" id="navToggle" type="button" aria-expanded="false" aria-controls="primaryNav">
      <span class="sr-only">Menu</span>
      <span class="bars" aria-hidden="true"></span>
    </button>

    <nav class="primary-nav" id="primaryNav" aria-label="Main">
      <ul>
        <li><a href="#movies">Movies</a></li>
        <li><a href="#gaming">Gaming</a></li>
        <li><a href="#pricing">Pricing</a></li>
        <li><a href="#visit">Visit</a></li>
      </ul>
      <a class="btn btn-primary nav-cta" href="#movies">Book a show</a>
    </nav>
  </div>
</header>

<main id="main">

  <!-- ============ HERO ============ -->
  <section class="hero" aria-labelledby="heroTitle">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Gaming cafe and cinema</p>
        <h1 id="heroTitle">Films on the big screen. Games at the next booth.</h1>
        <p class="lead">Pick a film, choose a showtime and pay by UPI. A show opens once five tickets are paid, so every screening has a proper crowd.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#movies">See showtimes</a>
          <a class="btn btn-ghost" href="#gaming">Explore the gaming zone</a>
        </div>
        <dl class="hero-facts">
          <div><dt>Ticket price</dt><dd>₹99</dd></div>
          <div><dt>Show opens at</dt><dd>5 tickets</dd></div>
          <div><dt>Seats per show</dt><dd>30</dd></div>
        </dl>
      </div>

      <figure class="hero-media">
        <img src="images/hero-cinema.jpg" alt="Audience seated in the 2B Zone screening room" width="1200" height="1500" data-media>
      </figure>
    </div>
  </section>

  <!-- ============ FILMS CAROUSEL ============ -->
  <section class="section" id="movies" aria-labelledby="moviesTitle">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="eyebrow">Now showing and upcoming</p>
        <h2 id="moviesTitle">Shows this week</h2>
        <p>Films rotate every few seconds. Hover, focus or swipe to pause. Pick a showtime to book your seats.</p>
      </header>

      <div class="carousel" id="carousel" tabindex="0" role="region" aria-roledescription="carousel" aria-label="Films and showtimes">
        <div class="carousel-track" id="track"></div>
        <div class="progress" aria-hidden="true"><span id="progressBar"></span></div>
      </div>

      <div class="carousel-bar">
        <div class="carousel-controls">
          <button class="icon-btn" id="prevBtn" type="button" aria-label="Previous film">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
          </button>
          <button class="icon-btn" id="nextBtn" type="button" aria-label="Next film">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
          <button class="icon-btn" id="toggleBtn" type="button" data-state="playing" aria-label="Pause slideshow">
            <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5v14M15 5v14"/></svg>
            <svg class="i-play solid" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5l11 7-11 7z"/></svg>
          </button>
        </div>
        <ol class="dots" id="dots" aria-label="Choose a film"></ol>
        <p class="counter" id="counter" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <!-- ============ HOW BOOKING WORKS ============ -->
  <section class="section section-alt" id="how" aria-labelledby="howTitle">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="eyebrow">How booking works</p>
        <h2 id="howTitle">Three steps to your seat</h2>
      </header>

      <ol class="steps">
        <li class="step" data-reveal>
          <span class="step-num" aria-hidden="true">01</span>
          <h3>Choose a film and time</h3>
          <p>Each showtime shows how many seats are left and how many tickets are needed to open it.</p>
        </li>
        <li class="step" data-reveal>
          <span class="step-num" aria-hidden="true">02</span>
          <h3>Pay by UPI</h3>
          <p>Send the total to our UPI ID, then enter the payment reference in the booking form.</p>
        </li>
        <li class="step" data-reveal>
          <span class="step-num" aria-hidden="true">03</span>
          <h3>Get confirmed</h3>
          <p>We check the payment and confirm your seats. Once five tickets are paid, the show is open.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============ GAMING ============ -->
  <section class="section" id="gaming" aria-labelledby="gamingTitle">
    <div class="container split">
      <figure class="split-media" data-reveal>
        <img src="images/gaming-zone.jpg" alt="Gaming booths with PCs and consoles at 2B Zone" width="1200" height="900" loading="lazy" data-media>
      </figure>

      <div data-reveal>
        <p class="eyebrow">Gaming zone</p>
        <h2 id="gamingTitle">Play before or after the film</h2>
        <p class="muted">Reserve a PC or console booth for your group, or combine a gaming session with a movie night.</p>
        <ul class="feature-list">
          <li><strong>PC booths</strong> for competitive titles and streaming setups</li>
          <li><strong>Console lounge</strong> with sofa seating for groups</li>
          <li><strong>Group reservations</strong> confirmed by phone or message</li>
        </ul>
        <p class="muted">Hourly booth rates: [add your rate]. Ask at the counter for group offers.</p>
        <a class="btn btn-ghost" href="#visit">Ask about a booth</a>
      </div>
    </div>
  </section>

  <!-- ============ PRICING ============ -->
  <section class="section section-alt" id="pricing" aria-labelledby="pricingTitle">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="eyebrow">Movie pricing</p>
        <h2 id="pricingTitle">One price per ticket</h2>
        <p>Every ticket costs ₹99. A show opens when five tickets are paid, so groups can book together.</p>
      </header>

      <div class="table-wrap" data-reveal>
        <table class="price-table">
          <caption class="sr-only">Movie ticket pricing options</caption>
          <thead>
            <tr>
              <th scope="col">Option</th>
              <th scope="col">Tickets</th>
              <th scope="col">Price</th>
              <th scope="col">Best for</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Single seat</th>
              <td>1</td>
              <td>₹99</td>
              <td>Joining a show that is already open</td>
            </tr>
            <tr>
              <th scope="row">Crew booking</th>
              <td>5</td>
              <td>₹495</td>
              <td>Opening a show for your group</td>
            </tr>
            <tr>
              <th scope="row">Full house</th>
              <td>30</td>
              <td>₹2,970</td>
              <td>Birthdays and private screenings</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============ VISIT & CONTACT ============ -->
  <section class="section" id="visit" aria-labelledby="visitTitle">
    <div class="container visit-grid">
      <div data-reveal>
        <p class="eyebrow">Visit us</p>
        <h2 id="visitTitle">Find 2B Zone</h2>
        <dl class="details">
          <dt>Address</dt>
          <dd>[Street address, area, city, PIN]</dd>
          <dt>Hours</dt>
          <dd>[Daily, for example 11:00 am to 11:00 pm]</dd>
          <dt>Phone</dt>
          <dd><a href="tel:+910000000000">[+91 00000 00000]</a></dd>
          <dt>Email</dt>
          <dd><a href="mailto:hello@example.com">[hello@yourdomain.com]</a></dd>
        </dl>
        <a class="btn btn-ghost" href="https://www.google.com/maps/search/?api=1&amp;query=2B+Zone" target="_blank" rel="noopener">Open in Google Maps</a>
      </div>

      <!-- Replace YOUR_FORM_ID with your Formspree form ID (see the setup instructions). -->
      <form class="contact-form" id="contactForm" action="https://formspree.io/f/YOUR_FORM_ID" method="POST" data-reveal>
        <h3>Send us a message</h3>
        <div class="field">
          <label for="contactName">Name</label>
          <input id="contactName" name="name" type="text" autocomplete="name" required>
        </div>
        <div class="field">
          <label for="contactPhone">Phone or email</label>
          <input id="contactPhone" name="contact" type="text" autocomplete="tel" required>
        </div>
        <div class="field">
          <label for="contactMessage">Message</label>
          <textarea id="contactMessage" name="message" rows="5" required></textarea>
        </div>
        <button class="btn btn-primary" id="contactSubmit" type="submit">Send message</button>
        <p class="form-status" id="formStatus" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

</main>

<!-- ============ FOOTER ============ -->
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="logo-text">2B Zone</p>
      <p>A gaming cafe and movie screening room for friends, families and groups.</p>
    </div>
    <nav aria-label="Footer">
      <h2 class="footer-title">Explore</h2>
      <ul class="footer-links">
        <li><a href="#movies">Movies</a></li>
        <li><a href="#gaming">Gaming</a></li>
        <li><a href="#pricing">Pricing</a></li>
        <li><a href="#visit">Visit</a></li>
      </ul>
    </nav>
    <div>
      <h2 class="footer-title">Payments</h2>
      <p>We accept UPI only. Keep your payment reference until your booking is confirmed.</p>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© <span id="year"></span> 2B Zone. All rights reserved.</p>
    <a href="#top">Back to top</a>
  </div>
</footer>

<!-- ============ BOOKING DIALOG ============ -->
<dialog class="booking-dialog" id="bookingDialog" aria-labelledby="bookingTitle">
  <div class="dialog-body">

    <div class="dialog-head">
      <div>
        <h2 id="bookingTitle">Book tickets</h2>
        <p>Pay the total by UPI, then enter the payment reference below.</p>
      </div>
      <button class="icon-btn" type="button" id="dialogClose" aria-label="Close booking">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    <form id="bookingForm" class="form-grid" novalidate>
      <div class="field full">
        <label for="filmSelect">Film</label>
        <select id="filmSelect"></select>
      </div>
      <div class="field full">
        <label for="timeSelect">Showtime</label>
        <select id="timeSelect"></select>
      </div>
      <div class="field">
        <label for="bookingDate">Date</label>
        <input type="date" id="bookingDate">
      </div>
      <div class="field">
        <label for="bookingQty">Tickets</label>
        <input type="number" id="bookingQty" min="1" max="30" value="1" inputmode="numeric">
      </div>
      <div class="field">
        <label for="bookingName">Name</label>
        <input type="text" id="bookingName" autocomplete="name">
      </div>
      <div class="field">
        <label for="bookingPhone">Mobile number</label>
        <input type="tel" id="bookingPhone" inputmode="numeric" autocomplete="tel" maxlength="12">
      </div>

      <div class="pay-summary full">
        <div class="pay-row">
          <span>Pay to UPI ID <button type="button" class="copy-btn" id="copyUpi">Copy</button></span>
          <strong id="upiText"></strong>
        </div>
        <div class="pay-row">
          <span>Price per ticket</span>
          <strong id="unitPrice"></strong>
        </div>
        <div class="pay-row pay-total">
          <span>Total</span>
          <strong id="payTotal">₹0</strong>
        </div>
      </div>

      <div class="field full">
        <label for="bookingRef">UPI reference (UTR)</label>
        <input type="text" id="bookingRef" autocomplete="off" spellcheck="false">
      </div>

      <p class="error-text full" id="bookingError" role="alert"></p>
      <div class="full">
        <button class="btn btn-primary btn-block" type="submit">Confirm booking</button>
      </div>
    </form>

    <div id="bookingSuccess" class="success-state" hidden>
      <h3>Booking received</h3>
      <p id="successText"></p>
      <button class="btn btn-ghost btn-block" type="button" id="successClose">Close</button>
    </div>

  </div>
</dialog>

</body>
</html>
