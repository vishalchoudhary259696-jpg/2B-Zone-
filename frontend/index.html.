  </footer>

</div>

<!-- ============ BOOKING MODAL ============ -->
<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="dialog">

    <div id="bookingView">
      <div class="dialog-head">
        <div>
          <h3 id="modalTitle">Book tickets</h3>
          <p>Pay the total by UPI, then enter the payment reference below.</p>
        </div>
        <button class="icon-btn" id="closeModal" aria-label="Close">✕</button>
      </div>

      <form id="bookingForm" novalidate>
        <label class="field">
          <span>Film</span>
          <select class="input" id="fMovie"></select>
        </label>

        <label class="field">
          <span>Showtime</span>
          <select class="input" id="fTime"></select>
        </label>

        <div class="grid-2">
          <label class="field">
            <span>Date</span>
            <input class="input" type="date" id="fDate" required />
          </label>
          <label class="field">
            <span>Tickets</span>
            <input class="input" type="number" id="fQty" min="1" max="30" value="1" required />
          </label>
        </div>

        <label class="field">
          <span>Name</span>
          <input class="input" type="text" id="fName" required />
        </label>

        <label class="field">
          <span>Mobile number</span>
          <input class="input" type="tel" id="fPhone" inputmode="numeric" maxlength="10" required />
        </label>

        <div class="pay-box">
          <div class="pay-line">
            <span>Price per ticket</span>
            <b>₹99</b>
          </div>
          <div class="pay-line">
            <span>UPI ID
              <button type="button" class="copy-btn" id="copyUpi">Copy</button>
            </span>
            <b id="upiId"></b>
          </div>
          <div class="pay-total">
            <span>Total</span>
            <span id="fTotal">₹99</span>
          </div>
        </div>

        <label class="field">
          <span>UPI reference / UTR</span>
          <input class="input" type="text" id="fRef" required />
        </label>

        <p class="error" id="fError"></p>
        <button class="btn btn-accent btn-block" type="submit">Confirm booking</button>
      </form>
    </div>

    <div id="successView" class="success-box" hidden>
      <div class="success-mark">✓</div>
      <h3>Booking received</h3>
      <p id="successText"></p>
      <button class="btn btn-outline btn-block" id="doneBtn">Close</button>
    </div>

  </div>
</div>

<script>
/* ==========================================================
   SETTINGS
   ========================================================== */
const SLIDE_MS     = 3500;          // time each film stays on screen
const MAX_PER_SHOW = 30;            // maximum tickets per show
const UNLOCK_AT    = 5;             // paid tickets needed to open a show
const PRICE        = 99;            // price per ticket (₹)
const UPI_ID       = "2bzone@upi";  // replace with your real UPI ID

/* ==========================================================
   FILM DATA
   poster: image path or URL (e.g. "posters/jailer2.jpg"). Empty = designed fallback.
   times:  sold = tickets already booked for that show (sample values).
   ========================================================== */
const movies = [
  {
    title: "Drishyam: The Conclusion",
    tag: "Now showing",
    lang: "Hindi",
    genre: "Crime · Thriller",
    meta: "Ajay Devgn, Tabu, Jaideep Ahlawat",
    desc: "Vijay Salgaonkar and his family come under pressure again as SP Rajveer Singh Tomar enters the story. The final chapter of the Hindi Drishyam franchise.",
    c1: "#2b3340", c2: "#0f1319",
    poster: "",
    times: [{ t: "10:30 AM", sold: 12 }, { t: "2:15 PM", sold: 4 }, { t: "7:00 PM", sold: 22 }]
  },
  {
    title: "Jailer 2",
    tag: "Opens 15 Oct",
    lang: "Tamil",
    genre: "Action · Drama",
    meta: "Rajinikanth",
    desc: "Rajinikanth returns in the sequel to the hit film Jailer, scheduled for release on 15 October 2026.",
    c1: "#3a2420", c2: "#100b0a",
    poster: "",
    times: [{ t: "11:00 AM", sold: 0 }, { t: "3:30 PM", sold: 7 }, { t: "9:00 PM", sold: 18 }]
  },
  {
    title: "Prahaar",
    tag: "Opens 16 Oct",
    lang: "Hindi",
    genre: "Drama",
    meta: "Rajkummar Rao · The Untold Story of Ujjwal Nikam",
    desc: "Rajkummar Rao's Hindi film on the untold story of Ujjwal Nikam, releasing 16 October 2026.",
    c1: "#1f2d26", c2: "#0a100d",
    poster: "",
    times: [{ t: "12:00 PM", sold: 3 }, { t: "4:45 PM", sold: 9 }, { t: "8:15 PM", sold: 0 }]
  },
  {
    title: "Ranabaali",
    tag: "Opens 16 Oct",
    lang: "Telugu",
    genre: "Period action drama",
    meta: "Vijay Deverakonda, Rashmika Mandanna",
    desc: "A period action drama set in 1870s South India during the great famine, starring Vijay Deverakonda and Rashmika Mandanna.",
    c1: "#1c2638", c2: "#080b12",
    poster: "",
    times: [{ t: "1:00 PM", sold: 6 }, { t: "5:30 PM", sold: 15 }, { t: "10:00 PM", sold: 1 }]
  }
];

/* ==========================================================
   ELEMENTS & STATE
   ========================================================== */
const $ = (id) => document.getElementById(id);
const slidesEl   = $("slides");
const stage      = $("stage");
const bar        = $("bar");
const counter    = $("counter");
const modal      = $("modal");
const navLinks   = $("navLinks");
const menuToggle = $("menuToggle");

let current   = 0;
let timer     = null;
let hovering  = false;
let modalOpen = false;
let paused    = false;

const pad = (n) => String(n).padStart(2, "0");

/* ==========================================================
   RENDERING
   ========================================================== */
function timesHTML(i) {
  return movies[i].times.map((s, j) => {
    const left = MAX_PER_SHOW - s.sold;
    const need = Math.max(0, UNLOCK_AT - s.sold);
    const pct  = Math.min(100, (s.sold / MAX_PER_SHOW) * 100);
    const status = need ? `${need} more to unlock` : "Show unlocked";
    return `
      <button class="show ${need ? "" : "unlocked"}" data-movie="${i}" data-time="${j}">
        <span class="show-time">${s.t}</span>
        <span class="show-meta">${left} of ${MAX_PER_SHOW} seats · ${status}</span>
        <span class="meter"><i style="width:${pct}%"></i></span>
      </button>`;
  }).join("");
}

function slideHTML(m, i) {
  return `
    <article class="slide" data-i="${i}" aria-hidden="true">
      <div class="slide-inner">
        <div class="poster" style="--c1:${m.c1};--c2:${m.c2}">
          <span class="poster-tag">${m.tag}</span>
          ${m.poster ? `<img src="${m.poster}" alt="${m.title} poster" onerror="this.remove()" />` : ""}
          <div class="poster-title">${m.title}</div>
        </div>

        <div class="info">
          <p class="kicker fx" style="--d:.2s">${m.genre}</p>
          <h3 class="fx" style="--d:.25s">${m.title}</h3>
          <dl class="specs fx" style="--d:.3s">
            <dt>Language</dt><dd>${m.lang}</dd>
            <dt>Cast</dt><dd>${m.meta}</dd>
            <dt>Status</dt><dd>${m.tag}</dd>
          </dl>
          <p class="desc fx" style="--d:.35s">${m.desc}</p>
          <p class="times-label fx" style="--d:.4s">Showtimes</p>
          <div class="times fx" style="--d:.45s">${timesHTML(i)}</div>
          <div class="actions fx" style="--d:.55s">
            <button class="btn btn-accent" data-book="${i}">Book this film →</button>
          </div>
        </div>
      </div>
    </article>`;
}

function build() {
  slidesEl.innerHTML = movies.map((m, i) => slideHTML(m, i)).join("");
}

function renderTimes(i) {
  document.querySelector(`.slide[data-i="${i}"] .times`).innerHTML = timesHTML(i);
}

/* ==========================================================
   CAROUSEL ANIMATION
   New film slides in from the LEFT, the previous one exits RIGHT
   ========================================================== */
function activate(n) {
  const slides = slidesEl.querySelectorAll(".slide");
  if (slides[current]) slides[current].classList.replace("active", "leaving");

  current = (n + movies.length) % movies.length;
  const next = slides[current];
  next.classList.remove("leaving", "active");
  void next.offsetWidth;          // restart the CSS animation
  next.classList.add("active");

  counter.innerHTML = `<b>${pad(current + 1)}</b> / ${pad(movies.length)}`;
  restartProgress();
}

function restartProgress() {
  bar.style.animation = "none";
  void bar.offsetWidth;
  bar.style.animation = `fill ${SLIDE_MS}ms linear forwards`;
  bar.style.animationPlayState = paused ? "paused" : "running";
}

function schedule() {
  clearTimeout(timer);
  if (paused) return;
  timer = setTimeout(() => {
    activate(current + 1);
    schedule();
  }, SLIDE_MS);
}

function go(n) {
  activate(n);
  schedule();
}

// Pause while hovered/touched or while the booking dialog is open
function syncPlay() {
  const shouldPause = hovering || modalOpen;
  if (shouldPause) {
    paused = true;
    clearTimeout(timer);
    bar.style.animationPlayState = "paused";
  } else if (paused) {
    paused = false;
    restartProgress();
    schedule();
  }
}

slidesEl.addEventListener("animationend", (e) => {
  if (e.target.classList.contains("leaving")) e.target.classList.remove("leaving");
});

/* ==========================================================
   CAROUSEL CONTROLS
   ========================================================== */
$("prev").addEventListener("click", () => go(current - 1));
$("next").addEventListener("click", () => go(current + 1));

stage.addEventListener("mouseenter", () => { hovering = true; syncPlay(); });
stage.addEventListener("mouseleave", () => { hovering = false; syncPlay(); });

let touchX = null;
stage.addEventListener("touchstart", (e) => {
  touchX = e.touches[0].clientX;
  hovering = true;
  syncPlay();
}, { passive: true });

stage.addEventListener("touchend", (e) => {
  if (touchX !== null) {
    const dx = e.changedTouches[0].clientX - touchX;
    if (Math.abs(dx) > 40) go(dx < 0 ? current + 1 : current - 1);
  }
  touchX = null;
  hovering = false;
  syncPlay();
});

// Showtime and "Book this film" clicks
slidesEl.addEventListener("click", (e) => {
  const t = e.target.closest("[data-time]");
  if (t) { openModal(+t.dataset.movie, +t.dataset.time); return; }
  const b = e.target.closest("[data-book]");
  if (b) openModal(+b.dataset.book, 0);
});

/* ==========================================================
   MOBILE MENU
   ========================================================== */
menuToggle.addEventListener("click", () => {
  const open = navLinks.classList.toggle("open");
  menuToggle.setAttribute("aria-expanded", String(open));
});
navLinks.querySelectorAll("a").forEach((a) =>
  a.addEventListener("click", () => {
    navLinks.classList.remove("open");
    menuToggle.setAttribute("aria-expanded", "false");
  })
);

/* ==========================================================
   BOOKING DIALOG
   ========================================================== */
const bookingView = $("bookingView");
const successView = $("successView");
const fMovie = $("fMovie");
const fTime  = $("fTime");
const fDate  = $("fDate");
const fQty   = $("fQty");
const fName  = $("fName");
const fPhone = $("fPhone");
const fRef   = $("fRef");
const fError = $("fError");
const fTotal = $("fTotal");

$("upiId").textContent = UPI_ID;

function todayISO() {
  const d = new Date();
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
}

function fillTimes(movieIdx, selected = 0) {
  fTime.innerHTML = movies[movieIdx].times.map((s, j) =>
    `<option value="${j}">${s.t} (${MAX_PER_SHOW - s.sold} seats left)</option>`
  ).join("");
  fTime.value = String(selected);
}

function updateTotal() {
  const qty = parseInt(fQty.value, 10) || 0;
  fTotal.textContent = "₹" + (PRICE * qty).toLocaleString("en-IN");
}

function openModal(movieIdx, timeIdx) {
  fMovie.innerHTML = movies.map((m, i) => `<option value="${i}">${m.title}</option>`).join("");
  fMovie.value = String(movieIdx);
  fillTimes(movieIdx, timeIdx ?? 0);
  fDate.min = todayISO();
  if (!fDate.value) fDate.value = todayISO();
  fQty.value = 1;
  updateTotal();
  fError.textContent = "";
  bookingView.hidden = false;
  successView.hidden = true;
  modal.classList.add("open");
  modalOpen = true;
  syncPlay();
}

function closeModal() {
  modal.classList.remove("open");
  modalOpen = false;
  syncPlay();
}

fMovie.addEventListener("change", () => {
  fillTimes(+fMovie.value);
  updateTotal();
});
fQty.addEventListener("input", updateTotal);
$("closeModal").addEventListener("click", closeModal);
$("doneBtn").addEventListener("click", closeModal);
modal.addEventListener("click", (e) => { if (e.target === modal) closeModal(); });
document.addEventListener("keydown", (e) => {
  if (e.key === "Escape" && modal.classList.contains("open")) closeModal();
});

$("copyUpi").addEventListener("click", async (e) => {
  try {
    await navigator.clipboard.writeText(UPI_ID);
    e.target.textContent = "Copied";
    setTimeout(() => (e.target.textContent = "Copy"), 1500);
  } catch {
    alert("UPI ID: " + UPI_ID);
  }
});

$("bookingForm").addEventListener("submit", (e) => {
  e.preventDefault();

  const i = +fMovie.value;
  const j = +fTime.value;
  const qty = parseInt(fQty.value, 10);
  const show = movies[i].times[j];
  const seatsLeft = MAX_PER_SHOW - show.sold;
  const name = fName.value.trim();
  const phone = fPhone.value.trim();
  const ref = fRef.value.trim();

  let err = "";
  if (!fDate.value) err = "Please choose a date.";
  else if (!name) err = "Please enter your name.";
  else if (!/^[6-9]\d{9}$/.test(phone)) err = "Enter a valid 10-digit mobile number.";
  else if (!qty || qty < 1) err = "Tickets must be at least 1.";
  else if (qty > seatsLeft) err = `Only ${seatsLeft} seats are left for this show.`;
  else if (!ref) err = "Please enter the UPI reference number.";

  if (err) {
    fError.textContent = err;
    return;
  }

  // Demo only: send this to your server or sheet and verify payment there.
  show.sold += qty;
  renderTimes(i);

  $("successText").textContent =
    `${qty} ticket(s) for ${movies[i].title} at ${show.t} on ${fDate.value}. ` +
    `Total ₹${(qty * PRICE).toLocaleString("en-IN")}. We will verify payment (ref ${ref}) and confirm your seats. ` +
    `The show opens after ${UNLOCK_AT} paid tickets.`;

  bookingView.hidden = true;
  successView.hidden = false;
});

/* ==========================================================
   INIT
   ========================================================== */
build();
activate(0);
schedule();
</script>
